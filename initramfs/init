#!/bin/sh

rescue() {
    echo "===[!ERROR!SORRY!]==="
    echo "initramfs: A critical step failed."
    echo "Please check the following:"
    echo "  1. Is the boot disk properly connected and detected?"
    echo "  2. Is the root= setting (UUID/partition) correct?"
    echo "  3. Run a filesystem check (fsck)."
    echo "Dropping to an emergency shell..."
    exec setsid cttyhack /bin/sh
}
mount -t proc proc /proc || rescue
mount -t sysfs sysfs /sys || rescue
mount -t devtmpfs devtmpfs /dev || rescue
clear || true
echo "==================="
echo "| forma initramfs |"
echo "|   version 1.0   |"
echo "==================="
echo ""
modprobe sirane_core || rescue
mkdir -p /newroot
mount /dev/sda1 /newroot || rescue

exec switch_root /newroot /sbin/init 
#└If this fails, it'll trigger a kernel panic and crash.